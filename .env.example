# Flask Environment
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Groq LLM API Key (Sign up at https://console.groq.com to get your key)
# Recommended models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Web Search API Key (Sign up at https://tavily.com to get 1000 free searches)
TAVILY_API_KEY=

# Application Mode:
# When set to true or when keys are missing, the system utilizes realistic AI simulation
# and simulated live web search data clearly tagged as Demo/Simulation Mode.
DEMO_MODE=true

# Database Path (defaults to instance/startup_validator.db)
DATABASE_PATH=startup_validator.db

# Server Configuration
PORT=5000
HOST=127.0.0.1
